{
    "name": "survelium/agent-analytics-php",
    "description": "Detect AI crawlers and AI-referred visitors server-side and report them to Survelium.",
    "keywords": [
        "survelium",
        "agent-analytics-php"
    ],
    "homepage": "https://github.com/survelium/agent-analytics-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Catalin Prodan",
            "email": "catalin.prodan@newpixel.ro",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Survelium\\AgentAnalytics\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survelium\\AgentAnalytics\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
